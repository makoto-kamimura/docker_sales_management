## Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_development

## Dify (AI接客)
# 公式 langgenius/dify を別ディレクトリ (~/dify/docker) で起動し、ホストの 8080 に bind する構成。
# Rails コンテナからは host.docker.internal 経由でアクセスする。
DIFY_API_BASE=http://host.docker.internal:8080/v1
DIFY_API_KEY=

## Mobile (Expo)
# lan: 同一LAN上のExpo Goから接続 (デフォルト・推奨)
# tunnel: ngrok経由で外部から接続 (@expo/ngrok 同梱済み)
# localhost: ホストのブラウザ/シミュレータからのみ接続
EXPO_HOST=lan
# 物理デバイス利用時は開発PCのLAN IPに変更 (例: 192.168.1.42)
REACT_NATIVE_PACKAGER_HOSTNAME=host.docker.internal
# モバイルからAPIへ繋ぐベースURL (LAN/トンネル時は開発PCのLAN IPに変更)
EXPO_PUBLIC_API_BASE=http://localhost/api

## カード決済 (Stripe。任意)
# STRIPE_SECRET_KEY と STRIPE_WEBHOOK_SECRET の両方がなければ、カード決済は無効 (画面にカードの選択肢を出さず、API は 503)。
# 開発・検証では Stripe のテスト用のキー (sk_test_...) を使う。Webhook の署名の秘密 (whsec_...) は、Stripe のダッシュボード
# または `stripe listen --forward-to localhost/api/v1/webhooks/stripe` が表示するものを指定する。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 決済の画面から戻る先 (Web の公開 URL)
APP_BASE_URL=http://localhost

## SSO (共通の認証サーバー。OpenID Connect。任意)
# 4 つがそろったときだけ有効。空なら SSO の経路は 404、画面のボタンも出ない。
# 認証サーバーに登録するリダイレクト URI は {PUBLIC_BASE_URL}/api/v1/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost
# 認証サーバーにパスキー (2 段階認証) でログインした人だけを通す (ID トークンの amr に mfa)
OIDC_REQUIRE_MFA=true
# モバイルの戻り先として許す URL の先頭 (ビルド版と Expo Go)
OIDC_MOBILE_REDIRECT_PREFIXES=craftflow://,exp://
# 非常用: true で「SSO だけ」の人もパスワードでログインできる
OIDC_ALLOW_PASSWORD_FOR_SSO_ONLY=false

## Embedding (任意 / 未設定時はmock vector)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API=https://api.openai.com/v1
