## Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_development

## Dify (AI接客)
# 公式 langgenius/dify を別ディレクトリ (~/dify/docker) で起動し、ホストの 8080 に bind する構成。
# Rails コンテナからは host.docker.internal 経由でアクセスする。
DIFY_API_BASE=http://host.docker.internal:8080/v1
DIFY_API_KEY=

## Mobile (Expo)
# lan: 同一LAN上のExpo Goから接続 (デフォルト・推奨)
# tunnel: ngrok経由で外部から接続 (@expo/ngrok 同梱済み)
# localhost: ホストのブラウザ/シミュレータからのみ接続
EXPO_HOST=lan
# 物理デバイス利用時は開発PCのLAN IPに変更 (例: 192.168.1.42)
REACT_NATIVE_PACKAGER_HOSTNAME=host.docker.internal
# モバイルからAPIへ繋ぐベースURL (LAN/トンネル時は開発PCのLAN IPに変更)
EXPO_PUBLIC_API_BASE=http://localhost/api

## Stripe (任意)
STRIPE_SECRET_KEY=

## Embedding (任意 / 未設定時はmock vector)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API=https://api.openai.com/v1
